# ============================================================
# WOJAN STUDIO — zmienne środowiskowe (skopiuj do .env)
# ============================================================

# Tryb działania: production włącza ścisłe CSP + HSTS + cache assetów
NODE_ENV=production

# Adres i port serwera
PORT=3000
HOST=0.0.0.0

# Ścieżka bazy danych (domyślnie: <projekt>/data/db.json)
# DB_PATH=/var/lib/wojan-studio/db.json

# (Opcjonalnie) ustaw na stały sekret w przyszłej wersji z JWT
# APP_SECRET=zmien-mnie-na-losowy-ciag
